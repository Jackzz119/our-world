VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# 开发用开关（getEnvFlag/getEnvOptional 读取，可省略，缺失 = false/空）：
# VITE_DEV          true = 开发自动登录：用下方 dev 账号真实 signInWithPassword 建立会话
#                   （不是跳过登录——无会话时 RLS 查不到任何数据，后端链路全会失败）。
#                   需同时填 VITE_DEV_EMAIL / VITE_DEV_PASSWORD 才生效，否则回到正常登录页。
# VITE_DEV_EMAIL    dev 自动登录账号邮箱（只放 .env.local，勿提交）
# VITE_DEV_PASSWORD dev 自动登录账号密码（只放 .env.local，勿提交）
# VITE_AUTO_ENTER   true = 有世界时挂载后自动进入；false = 正常玩家流程：先落大厅，点传送门进入。
VITE_DEV=false
VITE_DEV_EMAIL=
VITE_DEV_PASSWORD=
VITE_AUTO_ENTER=false
